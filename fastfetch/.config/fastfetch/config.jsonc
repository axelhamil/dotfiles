{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "magenta",
        "host": "blue"
      }
    },

    "separator",

    { "type": "os" },
    { "type": "host" },
    { "type": "kernel" },
    { "type": "uptime" },

    "separator",

    { "type": "packages" },
    { "type": "shell" },
    { "type": "terminal" },
    { "type": "terminalfont" },

    "separator",

    {
      "type": "cpu",
      "keyColor": "yellow",
      "outputColor": "default"
    },
    {
      "type": "gpu",
      "keyColor": "yellow",
      "outputColor": "default"
    },

    "separator",

    { "type": "memory" },
    { "type": "swap" },

    "separator",

    {
      "type": "disk",
      "folders": ["/"],
      "keyColor": "green"
    },

    "separator",

    {
      "type": "display",
      "compactType": "oneline"
    },

    "separator",

    { "type": "localip" },
    { "type": "publicip" },

    "separator",

    {
      "type": "locale",
      "keyColor": "cyan"
    }
  ]
}

// ═══════════════════════════════════════════════════════════════════════
// modules.jsonc — définitions PARTAGÉES par toutes les barres.
// Aucune barre ne redéfinit un module ici : les deux écrans sont
// identiques par construction, pas par copier-coller.
// ═══════════════════════════════════════════════════════════════════════
{
  "hyprland/workspaces": {
    "format": "{icon}",
    "sort-by": "number",
    "all-outputs": false,
    "show-special": false,
    "disable-scroll": true,
    "format-icons": {
      "active": "●",
      "default": "○",
      "empty": "○",
      "persistent": "○",
      "urgent": "●"
    },
    "persistent-workspaces": {
      "DP-2": ["1", "2", "3", "4"],
      "HDMI-A-1": ["5", "6", "7", "8"]
    },
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "max-length": 38,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Google Chrome": "$1",
      "(.*) — Zen Browser": "$1",
      "(.*)kitty": "$1",
      "(.*)": "$1"
    }
  },

  "clock": {
    "interval": 1,
    "timezone": "Europe/Paris",
    "locale": "fr_FR.UTF-8",
    "format": "{:L%a %d %b · %H:%M:%S}",
    "format-alt": "{:L%A %d %B %Y · %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'><b>{}</b></span>",
        "weeks": "<span color='#94e2d5'>W{}</span>",
        "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
        "today": "<span color='#f5e0dc'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // ── Cluster hardware : CPU% · CPU° · RAM Go · GPU%/° ───────────────
  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature", "memory", "custom/gpu"]
  },

  "cpu": {
    "interval": 2,
    "format": "<span color='#7f849c'>󰻠</span> {usage}%",
    "states": { "warning": 60, "critical": 85 },
    "tooltip": true,
    "on-click": "~/.config/waybar/popup.sh popup-btop kitty --class popup-btop -e btop"
  },

  "temperature": {
    "interval": 2,
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "format": "<span color='#7f849c'>󰔏</span> {temperatureC}°",
    "warning-threshold": 70,
    "critical-threshold": 88,
    "tooltip-format": "CPU package : {temperatureC}°C"
  },

  "memory": {
    "interval": 5,
    "format": "<span color='#7f849c'>󰍛</span> {used:0.1f}G",
    "states": { "warning": 75, "critical": 90 },
    "tooltip-format": "RAM  {used:0.1f}G / {total:0.1f}G  ({percentage}%)\nLibre  {avail:0.1f}G\nSwap  {swapUsed:0.1f}G / {swapTotal:0.1f}G",
    "on-click": "~/.config/waybar/popup.sh popup-btop kitty --class popup-btop -e btop"
  },

  "custom/gpu": {
    "format": "{}",
    "interval": 3,
    "exec": "~/.config/waybar/gpu-info.sh",
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.config/waybar/popup.sh popup-gpu kitty --class popup-gpu -e sh -c 'command -v nvtop >/dev/null && exec nvtop || exec btop'"
  },

  // ── Indicateurs d'état : chacun se masque tout seul quand il n'a
  //    rien à dire (script sans sortie => module invisible).
  "custom/docker": {
    "format": "<span color='#7f849c'>󰡨</span> {}",
    "interval": 15,
    "exec": "~/.config/waybar/docker-status.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/popup.sh popup-docker kitty --class popup-docker -e sh -c 'docker ps; read -r _'"
  },

  "custom/updates": {
    "format": "<span color='#7f849c'>󰚰</span> {}",
    "interval": 300,
    "exec": "~/.config/waybar/updates-cache.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/popup.sh popup-updates kitty --class popup-updates -e yay -Syu",
    "on-click-right": "~/.config/waybar/updates-info.sh"
  },

  "custom/obs": {
    "format": "{}",
    "interval": 3,
    "exec": "~/.config/waybar/obs-status.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/popup.sh com.obsproject.Studio obs"
  },

  "custom/nightlight": {
    "format": "{}",
    "interval": 5,
    "exec": "~/.config/waybar/nightlight.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/nightlight.sh toggle"
  },

  // ── Confidentialité : partage d'écran / micro / caméra actifs ──────
  "privacy": {
    "icon-spacing": 6,
    "icon-size": 13,
    "transition-duration": 200,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 22 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 22 }
    ]
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰛊"
    },
    "tooltip-format-activated": "Veille bloquée",
    "tooltip-format-deactivated": "Veille autorisée"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 mute",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "~/.config/waybar/popup.sh org.pulseaudio.pavucontrol pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "network": {
    "format-ethernet": "󰈀",
    "format-wifi": " {signalStrength}%",
    "format-disconnected": "󰈂",
    "tooltip-format-ethernet": "󰈀 Ethernet\n{ifname} : {ipaddr}/{cidr}\nPasserelle : {gwaddr}\n\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-wifi": " WiFi — {essid} ({signalStrength}%)\n{ifname} : {ipaddr}/{cidr}\n\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
    "tooltip-format-disconnected": "󰈂 Déconnecté",
    "interval": 3,
    "on-click": "~/.config/waybar/popup.sh nm-connection-editor nm-connection-editor",
    "on-click-right": "~/.config/waybar/popup.sh popup-nmtui kitty --class popup-nmtui -e nmtui"
  },

  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "tooltip-format": " Bluetooth\n{controller_alias}",
    "tooltip-format-connected": " Bluetooth\n{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "on-click": "~/.config/waybar/popup.sh blueman-manager blueman-manager",
    "on-click-right": "bluetoothctl power toggle"
  },

  "custom/notification": {
    "format": "{}",
    "interval": 2,
    "exec": "~/.config/waybar/notif-count.sh",
    "return-type": "json",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw"
  },

  "tray": {
    "icon-size": 13,
    "spacing": 8
  },

  "custom/shutdown": {
    "format": "⏻",
    "on-click": "wlogout -b 5 -B 500 -T 500",
    "tooltip": false
  }
}

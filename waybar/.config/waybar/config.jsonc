// ═══════════════════════════════════════════════════════════════════════
// Waybar — Split Islands
// Les deux barres sont STRICTEMENT identiques : elles n'ont ici que leur
// `output`. Tous les modules vivent dans modules.jsonc (partagé), donc
// aucune divergence possible entre DP-2 et HDMI-A-1.
// ═══════════════════════════════════════════════════════════════════════
[
  {
    "output": "DP-2",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
      "group/hardware",
      "custom/docker",
      "custom/updates",
      "custom/obs",
      "privacy",
      "idle_inhibitor",
      "custom/nightlight",
      "pulseaudio",
      "network",
      "bluetooth",
      "custom/notification",
      "tray",
      "custom/shutdown"
    ]
  },

  {
    "output": "HDMI-A-1",
    "include": ["~/.config/waybar/modules.jsonc"],
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [
      "group/hardware",
      "custom/docker",
      "custom/updates",
      "custom/obs",
      "privacy",
      "idle_inhibitor",
      "custom/nightlight",
      "pulseaudio",
      "network",
      "bluetooth",
      "custom/notification",
      "custom/shutdown"
    ]
  }
]

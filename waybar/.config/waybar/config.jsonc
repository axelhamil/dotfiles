[
  // ═══════════════════════════════════════════════
  // MAIN BAR — DP-5 (écran principal)
  // ═══════════════════════════════════════════════
  {
    "output": "DP-5",
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
      "hyprland/workspaces",
      "hyprland/window"
    ],
    "modules-center": [
      "mpris",
      "custom/cava"
    ],
    "modules-right": [
      "custom/obs",
      "gamemode",
      "custom/updates",
      "custom/dunst",
      "custom/docker",
      "group/systray",
      "group/hardware",
      "group/connectivity",
      "group/audio",
      "idle_inhibitor",
      "custom/nightlight",
      "custom/weather",
      "clock",
      "custom/shutdown"
    ],

    // ── Workspaces ──
    "hyprland/workspaces": {
      "format": "{id} {icon}",
      "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": ""
      },
      "persistent-workspaces": {
        "DP-5": [1, 2, 3, 4]
      }
    },

    // ── Active Window ──
    "hyprland/window": {
      "format": "{title}",
      "separate-outputs": true,
      "max-length": 45,
      "rewrite": {
        "(.*) — Mozilla Firefox": " $1",
        "(.*) - Google Chrome": " $1",
        "(.*) — Zen Browser": "󰈹 $1",
        "(.*)kitty": " $1",
        "(.*)": "$1"
      }
    },

    // ── Media Player (D-Bus, zero polling) ──
    "mpris": {
      "format": "{player_icon} {artist} — {title}",
      "format-paused": "{player_icon} {artist} — {title}",
      "format-stopped": "",
      "player-icons": {
        "brave": "",
        "firefox": "",
        "spotify": "",
        "chromium": "",
        "vlc": "󰕼",
        "mpv": "",
        "default": ""
      },
      "status-icons": {
        "playing": "",
        "paused": "",
        "stopped": ""
      },
      "max-length": 40,
      "on-click": "playerctl play-pause",
      "on-click-middle": "playerctl previous",
      "on-click-right": "playerctl next",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },

    // ── Audio Visualizer (cava via script) ──
    "custom/cava": {
      "exec": "~/.config/waybar/cava-waybar.sh",
      "exec-if": "which cava",
      "format": "{}",
      "tooltip": false,
      "max-length": 14,
      "restart-interval": 5
    },

    // ── OBS Status ──
    "custom/obs": {
      "format": "{}",
      "interval": 3,
      "exec": "~/.config/waybar/obs-status.sh",
      "return-type": "json",
      "tooltip": true
    },

    // ── GameMode ──
    "gamemode": {
      "format": "{glyph}",
      "glyph": "󰊗",
      "hide-not-running": true,
      "use-icon": false,
      "tooltip": true,
      "tooltip-format": "GameMode active\n{count} game(s) running"
    },

    // ── Arch Updates ──
    "custom/updates": {
      "format": "󰚰 {}",
      "interval": 3600,
      "exec": "~/.config/waybar/updates-info.sh",
      "exec-if": "[ $(checkupdates 2>/dev/null | wc -l) -gt 0 ]",
      "return-type": "json",
      "on-click": "kitty -e yay -Syu",
      "tooltip": true
    },

    // ── Notifications (Dunst) ──
    "custom/dunst": {
      "format": "󰂚 {}",
      "interval": 2,
      "exec": "~/.config/waybar/dunst-count.sh",
      "tooltip-format": "Clic: rappeler | Droit: DnD | Milieu: tout fermer",
      "on-click": "~/.config/waybar/dunst-history.sh",
      "on-click-right": "dunstctl set-paused toggle",
      "on-click-middle": "dunstctl close-all"
    },

    // ── Docker Status ──
    "custom/docker": {
      "format": "󰡨 {}",
      "interval": 10,
      "exec": "~/.config/waybar/docker-status.sh",
      "return-type": "json",
      "tooltip": true,
      "on-click": "kitty -e lazydocker"
    },

    // ── Hardware Drawer ──
    "group/hardware": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 400,
        "transition-left-to-right": true
      },
      "modules": [
        "custom/sysmon",
        "custom/gpu",
        "cpu",
        "memory",
        "disk"
      ]
    },

    "custom/sysmon": {
      "format": "󰒓 {}",
      "interval": 3,
      "exec": "~/.config/waybar/sysmon.sh",
      "return-type": "json",
      "tooltip": true,
      "on-click": "kitty -e btop"
    },

    "custom/gpu": {
      "format": "GPU {}°",
      "interval": 5,
      "exec": "~/.config/waybar/gpu-info.sh",
      "return-type": "json",
      "tooltip": true
    },

    "cpu": {
      "interval": 3,
      "format": " {usage}%",
      "tooltip-format": " CPU — {usage}%\nFréquence: {avg_frequency} GHz\n\nPar cœur:\n{usage0}%  {usage1}%  {usage2}%  {usage3}%\n{usage4}%  {usage5}%  {usage6}%  {usage7}%\n{usage8}%  {usage9}%  {usage10}% {usage11}%"
    },

    "memory": {
      "interval": 5,
      "format": "󰍛 {percentage}%",
      "format-alt": "󰍛 {used:0.1f}G",
      "tooltip-format": "󰍛 RAM — {percentage}%\nUtilisé: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    "disk": {
      "interval": 30,
      "format": "󰋊 {percentage_used}%",
      "path": "/",
      "tooltip-format": "󰋊 SSD — {percentage_used}%\nUtilisé: {used} / {total}\nLibre: {free}"
    },

    // ── Connectivity Drawer ──
    "group/connectivity": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 400,
        "transition-left-to-right": true
      },
      "modules": [
        "network",
        "bluetooth"
      ]
    },

    "network": {
      "format-ethernet": "󰈀",
      "format-wifi": "  {signalStrength}%",
      "format-disconnected": "󰈂",
      "tooltip-format-ethernet": "󰈀 Ethernet\n{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}\n\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
      "tooltip-format-wifi": " WiFi — {essid} ({signalStrength}%)\n{ifname}: {ipaddr}/{cidr}\n\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
      "tooltip-format-disconnected": "󰈂 Déconnecté",
      "interval": 2,
      "on-click": "~/.config/waybar/popup.sh nm-connection-editor nm-connection-editor",
      "on-click-right": "~/.config/waybar/popup.sh popup-nmtui kitty --class popup-nmtui -e nmtui"
    },

    "bluetooth": {
      "format": "",
      "format-connected": " {num_connections}",
      "format-disabled": "󰂲",
      "tooltip-format": " Bluetooth\n{controller_alias}\n{num_connections} appareil(s) connecté(s)",
      "tooltip-format-connected": " Bluetooth\n{controller_alias}\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "  {device_alias}",
      "on-click": "~/.config/waybar/popup.sh blueman-manager blueman-manager",
      "on-click-right": "bluetoothctl power toggle"
    },

    // ── Audio Drawer ──
    "group/audio": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 400,
        "transition-left-to-right": true
      },
      "modules": [
        "pulseaudio",
        "custom/audio-format",
        "pulseaudio#mic",
        "custom/patchbay"
      ]
    },

    "pulseaudio": {
      "scroll-step": 2,
      "format": "{icon} {volume}%",
      "format-muted": "󰖁 mute",
      "format-icons": {
        "headphone": "󰋋",
        "hands-free": "󰏾",
        "headset": "󰋎",
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "on-click": "~/.config/waybar/popup.sh org.pulseaudio.pavucontrol pavucontrol",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-middle": "~/.config/waybar/audio-switch.sh"
    },

    "custom/audio-format": {
      "format": "{}",
      "interval": 10,
      "exec": "~/.config/waybar/audio-info.sh",
      "return-type": "json",
      "tooltip": true
    },

    "pulseaudio#mic": {
      "format": "{format_source}",
      "format-source": "󰍬 {volume}%",
      "format-source-muted": "󰍭 mute",
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
      "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%+",
      "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 2%-"
    },

    "custom/patchbay": {
      "format": "󱡬",
      "tooltip-format": "PipeWire Patchbay",
      "on-click": "~/.config/waybar/popup.sh helvum helvum"
    },

    // ── Idle Inhibitor ──
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰅶",
        "deactivated": "󰾪"
      },
      "tooltip-format-activated": "Idle inhibitor: ON (screen won't lock)",
      "tooltip-format-deactivated": "Idle inhibitor: OFF"
    },

    // ── Night Light (hyprsunset) ──
    "custom/nightlight": {
      "format": "󰖔 {}",
      "interval": 3,
      "exec": "~/.config/waybar/nightlight.sh",
      "return-type": "json",
      "tooltip": true,
      "on-click": "~/.config/waybar/nightlight.sh toggle"
    },

    // ── Weather ──
    "custom/weather": {
      "interval": 600,
      "exec": "~/.config/waybar/wittr.sh Romorantin-Lanthenay",
      "return-type": "json",
      "format": "{}",
      "tooltip": true
    },

    // ── Clock ──
    "clock": {
      "interval": 1,
      "timezone": "Europe/Paris",
      "format": "{:%a %d %b  %H:%M:%S}",
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
        "mode": "year",
        "mode-mon-col": 3,
        "weeks-pos": "right",
        "on-scroll": 1,
        "on-click-right": "mode",
        "format": {
          "months": "<span color='#cba6f7'><b>{}</b></span>",
          "days": "<span color='#cdd6f4'><b>{}</b></span>",
          "weeks": "<span color='#94e2d5'>W{}</span>",
          "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
          "today": "<span color='#f5e0dc'><b><u>{}</u></b></span>"
        }
      },
      "actions": {
        "on-click-right": "mode",
        "on-scroll-up": "shift_up",
        "on-scroll-down": "shift_down"
      }
    },

    // ── System Tray Drawer ──
    "group/systray": {
      "orientation": "horizontal",
      "drawer": {
        "transition-duration": 400,
        "transition-left-to-right": true
      },
      "modules": [
        "custom/tray-icon",
        "tray"
      ]
    },

    "custom/tray-icon": {
      "format": "󰓨 {}",
      "interval": 2,
      "exec": "~/.config/waybar/tray-count.sh",
      "return-type": "json",
      "tooltip": true
    },

    "tray": {
      "icon-size": 15,
      "spacing": 8
    },

    // ── Power ──

    "custom/shutdown": {
      "format": "⏻",
      "on-click": "wlogout -b 5 -B 500 -T 500",
      "tooltip": false
    }
  },

  // ═══════════════════════════════════════════════
  // SECONDARY BAR — HDMI-A-3 (écran de droite)
  // ═══════════════════════════════════════════════
  {
    "output": "HDMI-A-3",
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 5,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
      "hyprland/workspaces"
    ],
    "modules-center": [
      "mpris"
    ],
    "modules-right": [
      "clock"
    ],

    "hyprland/workspaces": {
      "format": "{id} {icon}",
      "format-icons": {
        "5": "",
        "6": "",
        "7": "",
        "8": ""
      },
      "persistent-workspaces": {
        "HDMI-A-3": [5, 6, 7, 8]
      }
    },

    "mpris": {
      "format": "{player_icon} {artist} — {title}",
      "format-paused": "{player_icon} {artist} — {title}",
      "format-stopped": "",
      "player-icons": {
        "brave": "",
        "firefox": "",
        "spotify": "",
        "default": ""
      },
      "status-icons": {
        "playing": "",
        "paused": "",
        "stopped": ""
      },
      "max-length": 50,
      "on-click": "playerctl play-pause",
      "on-scroll-up": "playerctl next",
      "on-scroll-down": "playerctl previous"
    },

    "clock": {
      "interval": 1,
      "timezone": "Europe/Paris",
      "format": "{:%a %d %b  %H:%M:%S}"
    }
  }
]

{
  "diff_view_style": "split",
  "lsp_document_colors": "background",
  "code_lens": "menu",
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "tsserver": {
            "maxTsServerMemory": 8192
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "flexible": true,
    "sidebar_side": "right",
    "dock": "right",
    "enabled": true
  },
  "autosave": "off",
  "base_keymap": "JetBrains",
  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "buffer_font_size": 15,
  "calls": {
    "mute_on_join": true
  },
  "context_servers": {
    "icm": {
      "command": {
        "args": [
          "serve"
        ],
        "env": {},
        "path": "/usr/local/bin/icm"
      },
      "settings": {}
    },
    "mcp-server-github": {
      "enabled": true,
      "settings": {}
    }
  },
  "edit_predictions": {
    "mode": "eager"
  },
  "ensure_final_newline_on_save": true,
  "formatter": "language_server",
  "format_on_save": "on",
  "languages": {
    "TypeScript": {
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSX": {
      "language_servers": ["biome", "vtsls", "!typescript-language-server", "!eslint", "..."],
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JSON": {
      "language_servers": ["biome", "!json-language-server", "..."],
      "formatter": "language_server"
    },
    "JSONC": {
      "language_servers": ["biome", "!json-language-server", "..."],
      "formatter": "language_server"
    },
    "CSS": {
      "language_servers": ["biome", "..."],
      "formatter": "language_server"
    },
    "Markdown": {
      "soft_wrap": "preferred_line_length",
      "preferred_line_length": 80,
      "format_on_save": "off",
      "remove_trailing_whitespace_on_save": false,
      "extend_list_on_newline": true,
      "indent_list_on_tab": true,
      "show_edit_predictions": false
    }
  },
  "agent_ui_font_size": 15,
  "agent_buffer_font_size": 13,
  "git_gutter": "tracked_files",
  "icon_theme": {
    "dark": "Catppuccin Mocha",
    "light": "Zed (Default)",
    "mode": "dark"
  },
  "inlay_hints": {
    "enabled": false
  },
  "linked_edits": true,
  "project_panel": {
    "dock": "left",
    "bold_folder_labels": true,
    "git_status": true,
    "indent_size": 20,
    "show_diagnostics": "errors"
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.next",
    "**/.turbo",
    "**/.tanstack",
    "**/.cache",
    "**/.parcel-cache",
    "**/dist",
    "**/build",
    "**/out",
    "**/coverage",
    "**/.nuxt",
    "**/.output",
    "**/.svelte-kit",
    "**/.vercel",
    "**/.netlify",
    "**/target",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.gradle",
    "**/.idea",
    "**/.vscode",
    "**/.android",
    "**/android/app/build",
    "**/ios/Pods",
    "**/ios/build",
    "**/.expo",
    "**/.bundle",
    "**/Pods",
    "**/DerivedData",
    "**/*.tsbuildinfo"
  ],
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_session",
  "sticky_scroll": {
    "enabled": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "terminal": {
    "blinking": "terminal_controlled",
    "copy_on_select": true,
    "dock": "bottom",
    "shell": {
      "with_arguments": {
        "program": "/bin/zsh",
        "args": ["-l"]
      }
    },
    "working_directory": "current_file_directory"
  },
  "theme": {
    "dark": "Catppuccin Mocha",
    "light": "One Light",
    "mode": "dark"
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_menus": true
  },
  "ui_font_size": 16,
  "which_key": {
    "enabled": true
  },
  "minimap": {
    "show": "auto",
    "thumb": "always",
    "current_line_highlight": "line"
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "search_results": true,
    "selected_symbol": true,
    "diagnostics": "all"
  },
  "current_line_highlight": "all",
  "selection_highlight": true,
  "vertical_scroll_margin": 8,
  "scroll_beyond_last_line": "off",
  "hover_popover_delay": 200,
  "diagnostics": {
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": "warning"
    }
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "wrap_guides": [100],
  "redact_private_values": false,
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_file_finder": true,
    "enable_keep_preview_on_code_navigation": true
  },
  "expand_excerpt_lines": 5,
  "use_smartcase_search": true,
  "confirm_quit": false,
  "auto_install_extensions": {
    "html": true,
    "graphql": false,
    "astro": true,
    "biome": true
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_nav_history_buttons": false
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 600,
      "show_commit_summary": true
    }
  }
}
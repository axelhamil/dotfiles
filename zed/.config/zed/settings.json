// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
    "play_sound_when_agent_done": true
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "remote": false
    },
    "mcp-server-github": {
      "enabled": true,
      "remote": false
    }
  },
  "base_keymap": "Zed",
  "restore_on_startup": "last_workspace",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": "Catppuccin Mocha",
  "theme_overrides": {
    "Catppuccin Mocha": {
      "syntax": {
        "comment": { "font_style": "italic" },
        "comment.doc": { "font_style": "italic" },
        "keyword": { "font_style": "italic" },
        "type": { "font_style": "italic" },
        "variable.parameter": { "font_style": "italic" },
        "attribute": { "font_style": "italic" }
      }
    }
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_features": {
    "calt": true
  },
  "cursor_shape": "underline",
  "current_line_highlight": "line",
  "relative_line_numbers": "enabled",
  "tab_size": 2,
  "preferred_line_length": 120,
  "wrap_guides": [120],
  "colorize_brackets": true,
  "unnecessary_code_fade": 0.5,
  "auto_signature_help": true,
  "show_signature_help_after_edits": true,
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "prettier": {
    "allowed": false
  },
  "sticky_scroll": {
    "enabled": true
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware"
  },
  "scrollbar": {
    "show": "auto",
    "git_diff": true,
    "diagnostics": "all",
    "axes": {
      "horizontal": false,
      "vertical": true
    }
  },
  "project_panel": {
    "dock": "left",
    "git_status": true,
    "auto_reveal_entries": true,
    "auto_fold_dirs": true
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": true,
    "selections_menu": true,
    "agent_review": true,
    "code_actions": true
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_name": true,
    "show_project_items": true
  },
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 2,
    "runnables": false,
    "breakpoints": false,
    "bookmarks": false,
    "folds": false,
    "git_gutter_width": { "custom": 3 }
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "autosave": "on_focus_change",
  "code_lens": "on",
  "inline_code_actions": false,
  "inlay_hints": {
    "enabled": false,
    "toggle_on_modifiers_press": {
      "alt": true
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "diff_view_style": "split",
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "delay_ms": 400,
      "location": "inline",
      "show_commit_summary": false,
      "min_column": 80
    },
    "file_diff": {
      "show_full_file": true
    },
    "hunk_style": "staged_hollow",
    "show_stage_restore_buttons": true
  },
  "git_panel": {
    "tree_view": false,
    "dock": "right",
    "file_icons": true,
    "show_count_badge": true,
    "diff_stats": true,
    "group_by": "staging",
    "entry_primary_click_action": "file_diff",
    "starts_open": false
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "font_size": 15,
    "copy_on_select": true,
    "shell": {
      "program": "zsh"
    }
  },
  "file_types": {
    "Env": [".env", ".env.*"]
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.next",
    "**/dist",
    "**/coverage",
    "**/.turbo",
    "**/.output"
  ],

  "auto_install_extensions": {
    "biome": true,
    "caddyfile": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "github-actions": true,
    "github-actions-snippets": true,
    "html": true,
    "http": true,
    "hyprlang": true,
    "ini": true,
    "log": true,
    "make": true,
    "marksman": true,
    "mcp-server-context7": true,
    "mcp-server-github": true,
    "mcp-server-nextjs": true,
    "mcp-server-playwright": true,
    "mdx": true,
    "mermaid": true,
    "rainbow-csv": true,
    "scss": true,
    "sql": true,
    "tmux": true,
    "toml": true,
    "typescript-snippets": true,
    "xml": true
  },

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 8192
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "suggest": {
            "completeFunctionCalls": true
          },
          "preferences": {
            "importModuleSpecifier": "non-relative"
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "literals",
              "suppressWhenArgumentMatchesName": true
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          },
          "suggest": {
            "completeFunctionCalls": true
          },
          "preferences": {
            "importModuleSpecifier": "non-relative"
          },
          "inlayHints": {
            "parameterNames": {
              "enabled": "literals",
              "suppressWhenArgumentMatchesName": true
            },
            "parameterTypes": {
              "enabled": true
            },
            "variableTypes": {
              "enabled": true,
              "suppressWhenTypeMatchesName": true
            },
            "propertyDeclarationTypes": {
              "enabled": true
            },
            "functionLikeReturnTypes": {
              "enabled": true
            },
            "enumMemberValues": {
              "enabled": true
            }
          }
        }
      }
    },
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },

  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "!eslint"
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "!eslint"
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JSON": {
      "language_servers": ["json-language-server", "biome"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "JSONC": {
      "language_servers": ["json-language-server", "biome"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "HTML": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    }
  }
}

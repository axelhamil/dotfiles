// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "cursor": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "Zed",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "FiraCode Nerd Font",
  "buffer_font_features": {
    "calt": true
  },
  "project_panel": {
    "dock": "left"
  },
  "window_title_format": "${projectName}${separator}${fileName}",
  "autosave": "on_focus_change",
  "code_lens": "on",
  "inlay_hints": {
    "enabled": false,
    "toggle_on_modifiers_press": {
      "alt": true
    }
  },
  "session": {
    "trust_all_worktrees": true
  },
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 0,
      "location": "inline",
      "show_commit_summary": false
    }
  },
  "terminal": {
    "font_family": "FiraCode Nerd Font",
    "copy_on_select": true
  },

  "auto_install_extensions": {
    "biome": true,
    "caddyfile": true,
    "catppuccin": true,
    "catppuccin-icons": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "env": true,
    "git-firefly": true,
    "github-actions": true,
    "github-actions-snippets": true,
    "html": true,
    "http": true,
    "hyprlang": true,
    "ini": true,
    "log": true,
    "make": true,
    "marksman": true,
    "mcp-server-context7": true,
    "mcp-server-github": true,
    "mcp-server-nextjs": true,
    "mcp-server-playwright": true,
    "mdx": true,
    "mermaid": true,
    "rainbow-csv": true,
    "scss": true,
    "sql": true,
    "tmux": true,
    "toml": true,
    "typescript-snippets": true,
    "xml": true
  },

  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": {
            "maxTsServerMemory": 8192
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    },
    "biome": {
      "settings": {
        "require_config_file": true
      }
    }
  },

  "languages": {
    "TypeScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "TSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "!eslint"
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JavaScript": {
      "language_servers": ["vtsls", "biome", "!typescript-language-server", "!eslint"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JSX": {
      "language_servers": [
        "vtsls",
        "biome",
        "tailwindcss-language-server",
        "!typescript-language-server",
        "!eslint"
      ],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "prettier": { "allowed": false }
    },
    "JSON": {
      "language_servers": ["json-language-server", "biome"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "JSONC": {
      "language_servers": ["json-language-server", "biome"],
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    },
    "HTML": {
      "formatter": { "language_server": { "name": "biome" } },
      "format_on_save": "on",
      "prettier": { "allowed": false }
    }
  }
}

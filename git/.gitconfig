[user]
	name = axelhamil
	email = REDACTED@users.noreply.github.com
	signingkey = ~/.ssh/id_github
[init]
	defaultBranch = main
[commit]
	gpgsign = true
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[core]
	editor = nvim
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[color]
	ui = auto
[color "status"]
    added = green bold
    changed = magenta bold
    untracked = cyan bold

